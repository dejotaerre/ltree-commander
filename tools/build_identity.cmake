file(GLOB_RECURSE sources RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/src/*" "${SOURCE_DIR}/resources/*")
list(APPEND sources CMakeLists.txt tools/build_console_font.py tools/build_identity.cmake)
list(SORT sources)
set(identity "")
foreach(source IN LISTS sources)
    file(SHA256 "${SOURCE_DIR}/${source}" checksum)
    string(APPEND identity "${source}:${checksum}\n")
endforeach()
string(SHA256 identity "${identity}")
string(SUBSTRING "${identity}" 0 10 identity)
file(WRITE "${OUTPUT}.tmp" "#define LTREE_BUILD_ID \"${identity}\"\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
